# Copy to .env and set a long random webhook secret. Never commit .env.
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Kraken Futures API credentials. Keep these out of source control and TradingView.
# Use a dedicated key with trading/read permissions only; never grant withdrawals.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Dry run is the default. Keep false until demo-tested and independently reviewed.
ENABLE_LIVE_TRADING=false
KRAKEN_FUTURES_BASE_URL=https://futures.kraken.com
KRAKEN_FUTURES_SYMBOL=PI_XBTUSD

# PI_XBTUSD inverse contract value is configured as USD/contract; verify current specs.
CONTRACT_VALUE_USD=1
RISK_PER_TRADE_USD=10
STOP_LOSS_PCT=1.0
MAX_CONTRACTS=10
MAX_ORDER_NOTIONAL_USD=1000
DRY_RUN_CLOSE_SIZE=1
IDEMPOTENCY_DB=shotgun-events.sqlite3
PORT=8080
